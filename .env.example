# giscus configuration (https://giscus.app)
# Create a GitHub repo, enable Discussions, install the giscus app, then fill these in.
# The comment widget no-ops if these are left empty.
NEXT_PUBLIC_GISCUS_REPO=your-username/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Used for the per-chapter "open an issue" link.
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/your-username/your-repo
